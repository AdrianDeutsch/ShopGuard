#!/usr/bin/env bash
#
# Optional local gate: run the Playwright UI scenarios and the checks against the shop's
# database before a push leaves this machine.
#
# The pipeline runs the same scenarios on every push (job "ui" in .github/workflows/ci.yml).
# The hook brings the answer forward: a red scenario is caught here, not minutes later in CI.
# Enable it with:  git config core.hooksPath .githooks
#
# Bypass when you really need to (e.g. no Docker at hand):
#   SKIP_UI_TESTS=1 git push
set -euo pipefail

if [ "${SKIP_UI_TESTS:-0}" = "1" ]; then
  echo "pre-push: SKIP_UI_TESTS=1 set — skipping the UI gate."
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"

if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
  echo "pre-push: Docker is not available — cannot run the UI gate."
  echo "          Start Docker, or bypass once with: SKIP_UI_TESTS=1 git push"
  exit 1
fi

"$ROOT/scripts/start-toolshop.sh"

# @wip marks scenarios that describe a known, still open product defect (see docs/defects).
# They are expected to fail and must not block a push.
echo "pre-push: running UI + database scenarios (@ui, without @wip) against the local Toolshop..."
SHOPGUARD_ENV=selfhosted HEADLESS=true \
  dotnet test "$ROOT/ShopGuard/ShopGuard.E2ETests" -c Debug --filter "TestCategory=ui&TestCategory!=wip"

echo "pre-push: UI + database scenarios passed — proceeding with push."
echo "          Report: ShopGuard/ShopGuard.E2ETests/bin/Debug/net10.0/reqnroll-report.html"
